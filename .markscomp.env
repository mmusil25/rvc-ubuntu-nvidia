# .markscomp.env — machine-specific config for the realtime RVC GUI.
#
# Committed on purpose: nothing in here is sensitive. These are just the
# audio-device names and realtime-tuning knobs for ONE specific box. Clone the
# repo, edit these values for YOUR hardware, then run ./run-realtime-gui.sh.
#
# Discover the right values on your machine with:
#   pactl list short cards      ->  RVC_CARD
#   pactl list short sources    ->  RVC_NOISETORCH_SOURCE / RVC_RAW_MIC
#   pactl list short sinks
#
# The GPU is NOT configured here — it is auto-detected (CUDA -> cuda:0, else
# MPS/CPU). Any CUDA-capable NVIDIA GPU works; more VRAM just allows lower
# latency. Below ~4 GB VRAM is not realistically usable.

# --- Audio interface / capture (PulseAudio/PipeWire names) -------------------
RVC_CARD="alsa_card.usb-M-Audio_M-TRACK_DUO_HD_5000000001-01"
RVC_CARD_PROFILE="output:analog-stereo+input:analog-stereo"
# Preferred (denoised) capture source; falls back to RVC_RAW_MIC if absent.
RVC_NOISETORCH_SOURCE="NoiseTorch Microphone for M-TRACK DUO HD"
RVC_RAW_MIC="alsa_input.usb-M-Audio_M-TRACK_DUO_HD_5000000001-01.analog-stereo"

# --- Virtual cable -> voice-chat app (names are arbitrary; you invent them) --
RVC_SINK_NAME="RVC_to_Discord"
RVC_VIRTUAL_MIC="RVC_Virtual_Mic"

# --- Realtime CPU scheduling (see infer/lib/rt_priority.py) ------------------
RVC_CPU_AFFINITY=1     # pin main process to P-cores (auto-detected); 0 to disable
RVC_RT_PRIO=20         # audio-thread SCHED_FIFO priority; keep < PipeWire (~88); 0 disables

# --- Realtime debug instrumentation (see infer/lib/rt_debug.py) --------------
RVC_DEBUG=1
RVC_DEBUG_LOG="/tmp/rvc_debug.log"
RVC_DEBUG_INTERVAL=1.0
# RVC_DEBUG_SYNC=1     # accurate fea/index/f0/model GPU-time split (adds cuda syncs)
